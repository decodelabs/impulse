{
    "name": "decodelabs/impulse",
    "description": "PSR-14 compatible event hook system",
    "type": "library",
    "keywords": [ ],
    "license": "MIT",
    "authors": [ {
            "name": "Tom Wright",
            "email": "tom@inflatablecookie.com"
        } ],
    "require": {
        "php": "^8.4",
        "psr/event-dispatcher": "^1",

        "decodelabs/archetype": "^0.4",
        "decodelabs/exceptional": "^0.6.3",
        "decodelabs/kingdom": "^0.2",
        "decodelabs/monarch": "^0.2",
        "decodelabs/slingshot": "^0.3"
    },
    "require-dev": {
        "decodelabs/atlas": "^0.14.1",
        "decodelabs/genesis": "^0.14",
        "decodelabs/phpstan-decodelabs": "^0.7"
    },
    "conflict": {
        "decodelabs/atlas": "<0.14",
        "decodelabs/genesis": "<0.14"
    },
    "provide": {
        "psr/event-dispatcher-implementation": "1.0"
    },
    "suggest": {
        "decodelabs/atlas": "Enable hook map caching",
        "decodelabs/genesis": "Enable hook map caching"
    },
    "autoload": {
        "psr-4": {
            "DecodeLabs\\Impulse\\": "src/Impulse/"
        },
        "classmap": [
            "src/Impulse.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-develop": "0.4.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "decodelabs/genesis": true
        }
    }
}
